# Copy to .env and replace placeholders. Never commit real credentials.
APP_ENV=development
# Keep full locally. Set render-free on the Render backend to skip sync AI models.
INBOX_RUNTIME_PROFILE=full
DATABASE_URL=postgresql+psycopg://inbox:CHANGE_ME@localhost:5432/inbox_nizer
TEST_DATABASE_URL=postgresql+psycopg://inbox_test:CHANGE_ME@localhost:5432/inbox_nizer_test
# Shared project-relative directory for training, prediction and evaluation.
EMAIL_MODEL_PATH=results/email-classifier
GOOGLE_CLIENT_FILE=credentials.json
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/login/callback
BROWSER_ORIGIN=http://localhost:5173
# Generate locally with cryptography.fernet.Fernet.generate_key(); do not reuse example keys.
OAUTH_TOKEN_KEYS=
# Exact verified addresses invited for application sign-in (server-only).
GOOGLE_LOGIN_ALLOWED_EMAILS=
