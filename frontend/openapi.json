  "components": {
    "schemas": {
      "AnswerResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_evidence",
              "needs_clarification"
            ],
            "title": "Status"
          },
          "clarification_options": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ClarificationOption"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification Options"
          },
          "answer_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "deterministic_fact",
                  "extractive",
                  "generated_synthesis"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Mode"
          },
          "verification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "source_supported",
                  "not_semantically_verified"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sources",
          "citations",
          "status"
        ],
        "title": "AnswerResponse"
      },
      "BrowserSession": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "title": "BrowserSession"
      },
      "Citation": {
        "properties": {
          "email_id": {
            "type": "integer",
            "title": "Email Id"
          }
        },
        "type": "object",
        "required": [
          "email_id"
        ],
        "title": "Citation"
      },
      "ClarificationOption": {
        "properties": {
          "email_id": {
            "type": "integer",
            "title": "Email Id"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "date": {
            "type": "string",
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "email_id",
          "subject",
          "date"
        ],
        "title": "ClarificationOption"
      },
      "EmailRequest": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject"
          },
          "body": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "body"
        ],
        "title": "EmailRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "chunk_limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Chunk Limit",
            "default": 4
          },
          "max_chunks_per_email": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Max Chunks Per Email",
            "default": 2
          },
          "min_score": {
